<?xml version="1.0" encoding="utf-8"?>
<!--
  Zova — règles d'extraction de données (Android 12+).
  Objet : empêcher la copie des données de l'app (mémoires, transcripts,
  profil utilisateur, clés) vers une sauvegarde cloud ou un transfert
  d'appareil à appareil. Tout est exclu.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
