<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Avatar : photo si disponible, lettre sinon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <!-- Photo de la persona (chargée via Bitmap) -->
        <ImageView
            android:id="@+id/widget_avatar_img"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Fallback : première lettre du nom -->
        <TextView
            android:id="@+id/widget_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="Z"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#f0e6ff"
            android:gravity="center"
            android:background="#3b1d6e"
            android:padding="4dp" />

    </FrameLayout>

    <!-- Nom de la persona -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zova"
        android:textColor="#f0e6ff"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <!-- Dernière session -->
    <TextView
        android:id="@+id/widget_session"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#9c7dd9"
        android:textSize="9sp"
        android:layout_marginTop="2dp" />

    <!-- Démarrer -->
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶  Démarrer"
        android:textColor="#8b5cf6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

</LinearLayout>
